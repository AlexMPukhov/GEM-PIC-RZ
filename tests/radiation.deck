# Radiation reaction of the beam list (tests/radiation.sh): 100 GeV electrons (gamma = 2e5) in a helical wiggler,
# lambda_u = 1 cm, K = 20.6 (B0 = 22 T, |B| constant inside, linear ramps over one period at both ends), 7 cm. chi
# = 1.0e-3, about 7 photons per particle, 0.09 per sub-step (dz = lambda_u / 16): strongly non-Gaussian recoil.
grid {
  lambda0 = 0.8 um;  m_max = 1
  radial_grid = uniform;  dr = 1 um;  r_max = 40 um
  dzeta = 0.1 um;  window_length = 2 um
  dz = 0.625 mm;  z_end = 7 cm
}
undulator { type = helical; period = 1 cm; K = 20.6; periods = 7; ramp_periods = 1 }
bunch { name = b; charge = 1 fC; gamma = 2e5; sigma_x = 0.1 um; emittance_x = 0 um
        sigma_z = 0.1 um; zeta_center = 1 um; macroparticles = 100000 }
output { dir = rad_out; every = 0; format = hdf5; particles = true }
numerics { iterations = 1; beam_dz_max = 0.625 mm; beam_filter = 0; radiation_reaction = stochastic }
