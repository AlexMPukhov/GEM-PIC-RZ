# Dielectric wakefield accelerator (tests/dielectric.sh): a quartz-lined copper tube, vacuum channel r < 50 um,
# eps = 3.8 in 50 < r < 75 um, metal wall at 75 um, driven by a 100 pC, 10 um long, 5 GeV electron bunch. The bunch
# starts in vacuum with its co-moving field and enters the structure at z = 0.1 mm. tests/dielectric.py compares the
# on-axis wake behind the bunch with the modal theory (synchronous TM_0n modes).
grid {
  lambda0 = 0.8 um;  m_max = 0
  radial_grid = uniform;  dr = 0.5 um;  r_max = 80 um
  dzeta = 0.5 um;  window_length = 2300 um
  dz = 20 um;  z_end = 1.1 mm
}
wall { radius = 75 um }
dielectric { epsilon = 3.8; r_in = 50 um; r_out = 75 um; z_start = 0.1 mm }
bunch { name = driver; charge = 100 pC; energy = 5 GeV; sigma_x = 5 um; sigma_z = 10 um; zeta_center = 2260 um
        macroparticles = 200000; azimuthal_copies = 8 }
output { dir = dwa; every = 50; format = text; particles = false }
numerics { backend = serial }
