# Physics test: self-field of an ultra-relativistic flat-top bunch in vacuum,
# on a free-hand zeta grid (steps 2.5 ... 8 k0^-1 across the bunch).
# Expected: E_r = -(n_b sigma^2 / r)(1 - exp(-r^2/2 sigma^2)) (Gauss), E_z = 0.
# Checked by tests/check_physics (mode "bunchfield").
grid {
  lambda0 = 0.8 um;  m_max = 0
  radial_grid = stretched; dr_min = 0.5 k0^-1; dr_max = 10 k0^-1; r_transition = 30 k0^-1; r_max = 600 k0^-1
  zeta_grid = table;  zeta_points = 0, 1500, 3000, 5000 k0^-1;  dzeta_points = 8, 8, 2.5, 6 k0^-1
  window_length = 5000 k0^-1
  z_grid = table;  z_points = 0 k0^-1;  dz_points = 10 k0^-1;  z_end = 10 k0^-1
  r_absorber = 560 k0^-1
}
bunch { name = driver; charge = 5791.1 pC; gamma = 1e5; sigma_x = 20 k0^-1
        distribution_z = flattop; length = 4000 k0^-1; zeta_center = 2800 k0^-1; macroparticles = 600000 }
output { dir = bunch_vacuum_zeta_out; every = 1; map_stride = 2; particles = false }
