# Laser evolution benchmark (depletion, red-shift, self-focusing): GEM-PIC-RZ against FBPIC and the
# envelope code Wake-T on the same case (fbpic_laser.py, waket_laser.py), see ../README.md.
# a0 = 1.5, w0 = 3.56 um, field 1/e half length 2.04 um (tau = 6.79 fs),
# n0 = 0.01 n_c = 1.742e19 cm^-3 after a 10 um linear ramp, immobile ions, 300 um.
grid {
  lambda0           = 0.8 um
  m_max             = 1
  radial_grid       = stretched
  dr_min            = 0.3 k0^-1
  dr_max            = 2.0 k0^-1
  transition_cell   = 80
  transition_cells  = 10
  nr                = 130
  dzeta             = 0.2 k0^-1
  nzeta             = 980          # 196 k0^-1 = 24.95 um
  dz                = 2 um
  z_end             = 300 um
}
laser {
  a0          = 1.5
  waist       = 28 k0^-1          # 3.565 um
  length_1e   = 16 k0^-1          # 2.037 um (tau = 6.79 fs)
  zeta_center = 146 k0^-1         # 18.59 um, 50 k0^-1 behind the front of the window
}
plasma {
  density       = 0.01 n_c
  z_points      = 0, 10 um
  z_values      = 0, 1
  ppc_r         = 2
  ppc_phi       = 8
}
output { dir = gem_out; every = 5; maps = false; particles = false; format = text, hdf5 }
numerics { iterations = 2 }
