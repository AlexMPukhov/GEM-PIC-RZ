# Harmonics of a planar undulator: coherent spontaneous emission of a short bunch, against the radiation integral
# (radint.py), split into odd azimuthal modes (fundamental, 3rd harmonic) and even modes (2nd harmonic: off axis).
#  planar undulator, 10 periods of 10.667 mm, K = 1; gamma = 100: lambda_r = 0.8 um = lambda0
#  bunch 1 fC, sigma_z = 20 nm (form factor at 3 k_r 0.80), sigma_r = 5 um (transversely coherent to 1.3/gamma at 2 k_r)
grid {
  lambda0       = 0.8 um
  m_max         = 3               # odd harmonics in m = 1, 3; even harmonics in m = 0, 2
  radial_grid   = table
  r_points      = 0, 10, 300, 2000, 3000 um
  dr_points     = 0.5, 0.5, 3, 8, 25 um
  r_max         = 3 mm
  dzeta         = 6.25 nm         # 128 per lambda_r, 43 per lambda_r / 3
  window_length = 12 um
  dz            = 0.26667 mm      # 40 steps per period
  z_end         = 0.112 m
  r_absorber    = 2.3 mm
}
undulator { type = planar; period = 10.6667 mm; K = 1; periods = 10; ramp_periods = 1; natural_focusing = false }
bunch { name = b; charge = 1 fC; gamma = 100; sigma_x = 5 um; emittance_x = 0 um
        sigma_z = 0.02 um; zeta_center = 10.7 um; macroparticles = 200000 }
output { dir = em_out; every = 0; format = hdf5; particles = false }
numerics { iterations = 1; beam_dz_max = 0.13333 mm; beam_filter = 0 }
