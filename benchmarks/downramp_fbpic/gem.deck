# Density down-ramp injection benchmark: GEM-PIC-RZ against FBPIC (fbpic_downramp.py), see ../README.md.
# The laser of ../lwfa_fbpic with a0 = 1.8 enters a plateau of 2 n0, n0 = 0.002 n_c, which drops to n0 over 10 um:
# the wake lengthens behind the ramp, its back slows down, and background electrons are trapped there.
# GEM-PIC-RZ's level s is the plane z = s, so a profile n(z) along the propagation is represented exactly.
grid {
  lambda0           = 0.8 um
  m_max             = 1
  radial_grid       = stretched
  dr_min            = 0.3 k0^-1
  dr_max            = 3.0 k0^-1
  transition_cell   = 40
  transition_cells  = 8
  nr                = 100
  dzeta             = 0.25 k0^-1
  nzeta             = 1200
  dz                = 2.5 um
  z_end             = 200 um
  r_absorber        = 160 k0^-1
  absorber_strength = 0.2
}
laser {
  a0          = 1.8
  waist       = 63 k0^-1          # 8.0214 um
  length_1e   = 25 k0^-1          # 3.1831 um (tau = 10.618 fs)
  zeta_center = 240 k0^-1         # 30.56 um
}
plasma {
  density       = 0.002 n_c
  z_points      = 0, 20, 60, 70 um
  z_values      = 0, 2, 2, 1
  r_max         = 150 k0^-1       # 19.1 um
  ppc_r         = 2
  ppc_phi       = 8
  smooth_length = 2 k0^-1
}
output { dir = gem_out; every = 10; maps = false; particles = true }
numerics { iterations = 2 }
