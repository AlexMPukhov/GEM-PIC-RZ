&setup
  rootname = td201
  lattice  = fel.lat
  beamline = LINE
  lambda0  = 1.0625e-8
  gamma0   = 1000.0
  delz     = 0.000625
  npart    = 8192
  nbins    = 8
  shotnoise = 0
&end
&lattice
&end
&time
  slen   = 3.2e-6
  sample = 1
&end
&profile_step
  label   = cur
  c0      = 4000.0
  s_start = 0.0
  s_end   = 1.9e-6
&end
&field
  power      = 1.0e7
  waist_size = 30.0e-6
  dgrid      = 3.0e-4
  ngrid      = 201
&end
&field
  harm       = 2
  power      = 0
  waist_size = 30.0e-6
  dgrid      = 3.0e-4
  ngrid      = 201
&end
&field
  harm       = 3
  power      = 0
  waist_size = 30.0e-6
  dgrid      = 3.0e-4
  ngrid      = 201
&end
&beam
  current = @cur
  gamma   = 1000.0
  delgam  = 0.0
  ex      = 1.0e-9
  ey      = 1.0e-9
  betax   = 100.0
  betay   = 100.0
&end
&track
  output_step = 4
  bunchharm   = 3
&end
