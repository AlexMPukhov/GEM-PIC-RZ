# Seeded planar FEL with harmonics, reference run of the FEL paper (Table II, Figs. 2 and 3).
# benchmarks/harmonics/fel.deck with two changes:
#  1. Centred orbit: bunch.x0 = +x_w = K / (gamma k_u) = 2.387 um. The one-period entrance ramp shifts the planar
#     orbit by -x_w; loaded at +x_w, the beam swings symmetrically between +x_w and -x_w, which restores the
#     rotation-by-pi symmetry behind the parity rule (odd harmonics in odd m, even harmonics in even m).
#  2. Non-reflecting radial grid: uniform dr = 1 um out to the wall at r_max = 1 mm. A stretched grid reflects
#     radiation with k_perp dr >~ 1 (discrete cutoff k_perp = 2/dr; numerical total internal reflection where dr
#     grows). The largest k_perp that has to leave the beam is the 3rd-harmonic cone at 2 omega_1,
#     gamma theta = sqrt((1 + K^2/2)(3/2 - 1)) = 1.03, k_perp = 1.25 /um, below the cutoff 2 /um.
#     Cost: 1000 radial cells instead of 122, about 44 GB of memory.
# Table II: lambda_u/32,  gempic_rz fel_clean.deck grid.dz=0.3125mm numerics.beam_dz_max=0.3125mm
# Fig. 3:   lambda_u/16 (this deck) with an HDF5 frame at z = 0.9 m: output.format=both output.every=1440
grid {
  lambda0       = 10.625 nm
  m_max         = 2               # 2nd harmonic in m = 0, 2; fundamental and on-axis 3rd harmonic in m = 1
  radial_grid   = uniform
  dr            = 1 um
  r_max         = 1 mm
  dzeta         = 0.33203 nm      # lambda_r / 32
  window_length = 6.1 um
  dz            = 0.625 mm        # lambda_u / 16 with the mean-field beam push
  z_end         = 1.0 m
  r_absorber    = 2 mm            # off
}
undulator { type = planar; period = 1 cm; K = 1.5; periods = 100; ramp_periods = 1; natural_focusing = false }
bunch {
  name           = b
  charge         = 28.02 pC       # 4 kA over 2.1 um (flat part + half the edges)
  gamma          = 1000
  sigma_x        = 10 um
  emittance_x    = 0 um
  distribution_z = function
  profile_z      = "zeta < 2.62 um ? sin(pi / 2 * (zeta - 2.52 um) / (0.1 um))^2 : zeta > 4.52 um ? sin(pi / 2 * (4.62 um - zeta) / (0.1 um))^2 : 1"
  zeta_min       = 2.52 um
  zeta_max       = 4.62 um
  macroparticles = 640000
  shot_noise     = fawley
  beamlet        = 8
  noise_wavelength = 10.625 nm
  axis_refine    = 16
  axis_radius    = 4 um
  x0             = 2.387 um       # centred orbit
}
laser {
  a0                = 7.6375e-6   # 10 MW seed
  waist             = 30 um
  envelope_function = "zeta < 1.42 um ? 0 : zeta < 1.52 um ? sin(pi / 2 * (zeta - 1.42 um) / (0.1 um))^2 : zeta < 4.57 um ? 1 : zeta < 4.67 um ? sin(pi / 2 * (4.67 um - zeta) / (0.1 um))^2 : 0"
  zeta_center       = 3.02 um
  polarization      = linear      # along x, the wiggle plane
}
output { dir = out; format = text; particles = false; fel_slice = 0.2125 um; fel_harmonics = 3; every = 800
         checkpoint_every = 800; checkpoint_keep = 1 }
numerics { iterations = 1; beam_dz_max = 0.625 mm; beam_filter = 0; backend = openmp }
