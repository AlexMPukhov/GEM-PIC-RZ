&setup
  rootname = seeded
  lattice  = fel.lat
  beamline = LINE
  lambda0  = 0.8e-9
  gamma0   = 5000.0
  delz     = 0.00125
  npart    = 8192
  nbins    = 4
  shotnoise = 0
&end
&lattice
&end
&field
  power      = 1.0e7
  waist_size = 30.0e-6
  dgrid      = 2.0e-4
  ngrid      = 301
&end
&beam
  current = 4000.0
  gamma   = 5000.0
  delgam  = 0.0
  ex      = 1.0e-9
  ey      = 1.0e-9
  betax   = 500.0
  betay   = 500.0
&end
&track
  output_step = 16
&end
