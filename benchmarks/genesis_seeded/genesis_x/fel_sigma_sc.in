  ngrid      = 301
&end
&beam
  current = 4000.0
  gamma   = 5000.0
  delgam  = 0.0
  ex      = 5.7e-8
  ey      = 5.7e-8
  betax   = 8.7
  betay   = 8.7
&end
&efield
  nz    = 1
  nphi  = 0
  ngrid = 200
  rmax  = 1.0e-4
&end
&track
  output_step = 16
&end
