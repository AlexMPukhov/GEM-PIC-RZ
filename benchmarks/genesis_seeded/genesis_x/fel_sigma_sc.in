&setup
  rootname = seeded_sigma_sc
  lattice  = fel.lat
  beamline = LINE
  lambda0  = 0.8e-9
  gamma0   = 5000.0
  delz     = 0.00125
  npart    = 8192
  nbins    = 4
  shotnoise = 0
&end
&lattice
&end
&field
  power      = 1.0e7
  waist_size = 30.0e-6
