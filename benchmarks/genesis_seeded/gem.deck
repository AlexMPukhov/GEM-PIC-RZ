# Seeded FEL amplifier: GEM-PIC-RZ against GENESIS 1.3 v4 (steady state), see README.md here.
#  helical undulator, period 1 cm, K = 1, 60 periods (no natural focusing in both codes)
#  beam 511 MeV (gamma = 1000), 4 kA, sigma_r = 10 um, zero emittance, no energy spread
#  lambda_r = lambda_u (1 + K^2) / (2 gamma^2) = 10 nm = lambda0; rho = 0.009
#  seed: Gaussian beam, w0 = 30 um at the undulator entrance, 10 MW, circular polarization
#  The bunch is a 2 um flat top (200 lambda_r, smooth 0.1 um edges) much longer than the
#  slippage (0.6 um): its middle part is in the steady state of GENESIS.
grid {
  lambda0       = 10 nm
  m_max         = 1
  radial_grid   = table
  r_points      = 0, 40, 400, 2300 um
  dr_points     = 1, 1,  20,  50   um
  r_max         = 2.3 mm
  dzeta         = 0.625 nm
  window_length = 5900 nm
  dz            = 0.625 mm
  z_end         = 0.6 m
  r_absorber    = 3 mm      # off
}
undulator { type = helical; period = 1 cm; K = 1; periods = 60; ramp_periods = 1 }
bunch {
  name           = b
  charge         = 26.69 pC            # 4 kA over 2 um (flat part) + edges
  gamma          = 1000
  sigma_x        = 10 um
  emittance_x    = 0 um
  distribution_z = function
  profile_z      = "zeta < 2.3 um ? sin(pi / 2 * (zeta - 2.2 um) / (0.1 um))^2 : zeta > 4.3 um ? sin(pi / 2 * (4.4 um - zeta) / (0.1 um))^2 : 1"
  zeta_min       = 2.2 um
  zeta_max       = 4.4 um
  macroparticles = 440000
  shot_noise     = fawley
  noise_wavelength = 10 nm
}
laser {
  a0                = 5.0834e-6         # seed power 10 MW (circular: P = 2 x 21.5 GW (a0 w0 / lambda)^2)
  waist             = 30 um
  envelope_function = "zeta < 1.5 um ? 0 : zeta < 1.6 um ? sin(pi / 2 * (zeta - 1.5 um) / (0.1 um))^2 : zeta < 4.5 um ? 1 : zeta < 4.6 um ? sin(pi / 2 * (4.6 um - zeta) / (0.1 um))^2 : 0"
  zeta_center       = 3.3 um
  polarization      = circular
  helicity          = -1               # the resonant sense of rotation for this undulator field
}
output { dir = gem_out; every = 0; format = text; maps = false; axis = false; particles = false; fel_slice = 0.2 um }
numerics { iterations = 1; beam_dz_max = 0.625 mm; beam_filter = 0 }
