# GPU performance deck: the LWFA benchmark of ../lwfa_fbpic (validated against FBPIC), 16x more plasma particles
# (8 x 32 per cell: ~4e4 per slice, enough to fill a GPU) and 0.5 mm of propagation (200 steps).
# CPU reference (this container, 2 cores, OpenMP): 10.6 s per step.
grid {
  lambda0           = 0.8 um
  m_max             = 1
  radial_grid       = stretched
  dr_min            = 0.3 k0^-1
  dr_max            = 3.0 k0^-1
  transition_cell   = 40
  transition_cells  = 8
  nr                = 100
  dzeta             = 0.25 k0^-1
  nzeta             = 1200
  dz                = 2.5 um
  z_end             = 500 um
  r_absorber        = 160 k0^-1
  absorber_strength = 0.2
}
laser {
  a0          = 2
  waist       = 63 k0^-1          # 8.0214 um
  length_1e   = 25 k0^-1          # 3.1831 um (tau = 10.618 fs)
  zeta_center = 240 k0^-1         # 30.56 um
}
plasma {
  density       = 0.002 n_c
  z_points      = 0, 20 um
  z_values      = 0, 1
  r_max         = 150 k0^-1       # 19.1 um
  ppc_r         = 8
  ppc_phi       = 32
}
output { dir = gpu_heavy; every = 40; maps = false; particles = false }
numerics { iterations = 2 }
