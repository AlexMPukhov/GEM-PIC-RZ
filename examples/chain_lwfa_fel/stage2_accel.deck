# Stage 2 of the chained example (README.md): long acceleration of the beam injected in stage 1 (FBPIC).
# The laser starts again at its focus with the parameters of stage 1 and propagates in the matched channel of
# stage 1 (n0 = 0.002 n_c, Delta n(w0) = 0.5 n0); the beam is placed behind the laser centre at the distance it
# had at the end of stage 1 (handoff.py prints bunch.zeta_center). Exit ramp of 0.2 mm, then the beam leaves the
# plasma; its particles are written as openPMD (species 'witness') at z_end.
#   run (run_chain.sh does it):  gempic_rz stage2_accel.deck bunch.zeta_center=<from handoff.py>
grid {
  lambda0           = 0.8 um
  m_max             = 1
  radial_grid       = stretched
  dr_min            = 0.3 k0^-1
  dr_max            = 3.0 k0^-1
  transition_cell   = 40
  transition_cells  = 8
  nr                = 100
  dzeta             = 0.25 k0^-1
  nzeta             = 1200            # window 38.2 um
  dz                = 2.5 um
  z_end             = 1.4 mm
  r_absorber        = 160 k0^-1
  absorber_strength = 0.2
}
laser {
  a0          = 1.8
  waist       = 63 k0^-1              # 8.02 um
  length_1e   = 25 k0^-1              # 3.18 um (tau = 10.6 fs)
  zeta_center = 240 k0^-1             # 30.56 um
}
plasma {
  density        = 0.002 n_c          # n0 = 3.48e18 cm^-3: the density behind the down-ramp of stage 1
  z_points       = 0, 1.2, 1.4 mm     # n0 to 1.2 mm, exit ramp to 1.4 mm
  z_values       = 1, 1,   0
  radial_profile = parabolic
  channel_depth  = 0.5
  r_channel      = 63 k0^-1
  r_max          = 150 k0^-1
  ppc_r          = 2
  ppc_phi        = 8
  smooth_length  = 2 k0^-1
}
bunch {
  name        = witness
  file        = stage1/hdf5/data00006000.h5   # FBPIC openPMD output (species 'electrons', u_z > 10)
  select      = "gamma > 20"                  # the injected beam
  zeta_center = 12 um                         # set by run_chain.sh from handoff.py
}
output {
  dir       = stage2
  every     = 80
  maps      = false
  particles = true
  format    = text, openpmd
}
numerics {
  iterations = 2
  trap_gamma = 4                      # count only electrons accelerated by the wake as 'trapped'
}
