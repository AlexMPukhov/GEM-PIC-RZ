# ============================================================================
#  Compact high-gain FEL (SASE from the macroparticle noise)
#
#  helical undulator: period 1 cm, K = 1, 60 periods; electron bunch 511 MeV
#  (gamma = 1000), 4 kA, sigma_r = 10 um, flat-top 1.3 um = 130 lambda_r.
#  lambda_r = lambda_u (1 + K^2) / (2 gamma^2) = 10 nm = lambda0.
#  FEL parameter rho = 0.009: 1D gain length 5.1 periods, Ming Xie 6.4
#  periods; 2 pi L_c = 55 lambda_r. The simulation gives a power gain length
#  of 6.3 periods in the exponential stage (README "Undulators").
#  About 7.7 minutes on 2 cores (6880 slices x 131 radial cells x 961 steps).
#
#  The bunch must be several cooperation lengths long: radiation slips
#  forward by one lambda_r per period and leaves a bunch of a few lambda_r
#  before it can be amplified.
#
#  run:      gempic_rz examples/fel_sase.deck
#  analyse:  h5_extract fel_sase/data_00960.h5 energy        (W(m>=1): radiation)
#            bunching from /particles/beam/zeta (k_r = k0): |<exp(i zeta)>|
# ============================================================================

grid {
  lambda0       = 10 nm             # = resonant wavelength
  m_max         = 1                 # circular polarization: mode 1
  # radial boundary at the reach of the space-charge field, gamma L = 1.3 mm
  # (summary line "box for bunch"): 1 um near the bunch, growing to 50 um
  radial_grid   = table
  r_points      = 0, 40, 400, 1500 um
  dr_points     = 1, 1,  20,  50   um
  r_max         = 1.5 mm
  dzeta         = 0.625 nm          # 16 slices per lambda_r
  window_length = 4300 nm           # slippage 600 nm + bunch + space-charge gaps (>= 1.14 um) at both ends
  dz            = 0.625 mm          # 16 steps per period
  z_end         = 0.6 m
  r_absorber    = 3 mm              # off (beyond r_max): the self-field reaches the wall
}

undulator {
  type         = helical
  period       = 1 cm
  K            = 1
  periods      = 60
  ramp_periods = 1
}

bunch {
  name           = b
  charge         = 17.345 pC        # 4 kA over 1.3 um
  gamma          = 1000
  sigma_x        = 10 um
  emittance_x    = 0 um
  distribution_z = flattop
  length         = 1300 nm
  zeta_center    = 2450 nm
  macroparticles = 200000
}

output {
  dir       = fel_sase
  every     = 64
  format    = hdf5
  particles = true
}

numerics {
  iterations  = 1                   # vacuum: no streaming particles
  beam_dz_max = 0.625 mm
  beam_filter = 0                   # the filter would damp the current at lambda_r by cos^2(pi/16)
  beam_pusher = vay                 # (default) keeps E + v x B = 0 of the beam's own field
}
