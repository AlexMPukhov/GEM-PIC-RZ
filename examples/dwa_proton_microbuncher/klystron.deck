# GEM-PIC-RZ deck generated by examples/dwa_proton_microbuncher/make_deck.py
#   arguments: --protons --klystron --p-quads 300
# Quartz-lined copper tube (Rc = 1 mm, eps = 3.75, Rw = 1.061 mm): synchronous TM01 at 996 um (301 GHz),
# TM02 194 um, TM03 100 um; the wake of 5 nC behind the bunch ~ 127 MV/m (modal theory, tests/dielectric.py).
# Electron drive beam 600 MeV, 5 nC, external FODO (period 0.110 m, quadrupoles 0.047 m, G0 = 1000 T/m).
grid {
  lambda0 = 10 um;  m_max = 1                       # code units only; m = 1: dipole wakes (BBU / hosing)
  radial_grid = table;  r_max = 1.07 mm
  r_points  = 0, 0.3, 0.45, 0.85, 0.97 mm         # fine at the beam, coarser in the channel,
  dr_points = 5, 5, 15, 15, 3 um                   #   3 um in the 61 um quartz layer (k_perp dr << 1)
  dzeta = 4 um;  window_length = 30.0 mm
  dz = 2.000 mm;  z_end = 10.5600 m
}
wall { radius = 1.061 mm }                         # copper jacket
dielectric { epsilon = 3.75; r_in = 1 mm; r_out = 1.061 mm; z_start = 0.0100 m; z_end = 5.0100 m }
dielectric { epsilon = 3.75; r_in = 1 mm; r_out = 1.061 mm; z_start = 5.5100 m; z_end = 10.5100 m }
bunch { name = driver; charge = 5.000 nC; energy = 600.000 MeV; energy_spread = 0.1 %
        sigma_x = 50 um; sigma_y = 50 um; emittance_x = 1 um; emittance_y = 1 um   # normalized, 1 mm mrad
        sigma_z = 0.1 mm; zeta_center = 29.000 mm; x0 = 10.0 um
        macroparticles = 400000; azimuthal_copies = 8 }   # copies: m = 1 driven by the offset, not by noise
# slice of a 400 GeV SPS proton bunch (3e11 p, sigma_z = 12 cm: ~1e9 p/mm near the centre) behind the driver;
# its energy modulation by the wake is the microbunching
bunch { name = protons; species = proton; charge = 4.000 nC; energy = 400 GeV; energy_spread = 0.03 %
        sigma_x = 0.2 mm; sigma_y = 0.2 mm; emittance_x = 3 um; emittance_y = 3 um
        distribution_z = flattop; length = 25.00 mm; zeta_center = 15.500 mm
        macroparticles = 1000000; azimuthal_copies = 8 }
# FODO channel of the first structure (gradients follow the energy of the bunch centre)
quadrupole { z_start = 0.014000 m; length = 0.0470 m; gradient = 1000.000 T/m }
quadrupole { z_start = 0.069000 m; length = 0.0470 m; gradient = -995.406 T/m }
quadrupole { z_start = 0.124000 m; length = 0.0470 m; gradient = 990.812 T/m }
